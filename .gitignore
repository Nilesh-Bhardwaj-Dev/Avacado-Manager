# Dependencies
node_modules/

# Environment & secrets (never commit)
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / uploads
uploads/*
!uploads/.gitkeep

# Test & coverage
coverage/
.nyc_output/

# Vite / cache
.vite/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Optional local scratch / experiments
scratch/
tmp/
temp/

# Security / keys (extra safety)
*.pem
*.key
credentials.json
secrets.json
