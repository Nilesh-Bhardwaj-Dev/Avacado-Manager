MONGODB_URI=mongodb://localhost:27017/task_management
PORT=5000
NODE_ENV=development

# JWT (required in production — use: openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=task-management-saas
JWT_AUDIENCE=task-management-api

# Cookies (production)
# COOKIE_DOMAIN=.yourdomain.com
# CORS_ORIGIN=https://app.yourdomain.com

APP_URL=http://localhost:3000
APP_NAME=Task Manager

# Account security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_HISTORY_COUNT=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudinary (optional)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

LOG_LEVEL=info

# RBAC
RBAC_LEGACY_MODE=true
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_SELF_SERVE_ORG=false
EMAIL_VERIFICATION_EXPIRES_HOURS=24
INVITATION_EXPIRES_HOURS=72
# Set to true once to migrate legacy admin workspaces
RUN_RBAC_MIGRATION=false
